local function showBanner(show)
	if show then
		banner.Visible = true
		TweenService:Create(banner, TweenInfo.new(0.35, Enum.EasingStyle.Quad),
			{Position = UDim2.new(0.5, 0, 0, 20)}):Play()
	else
		local t = TweenService:Create(banner, TweenInfo.new(0.3, Enum.EasingStyle.Quad),
			{Position = UDim2.new(0.5, 0, 0, -60)})
		t:Play()
		t.Completed:Connect(function()
			if not enabled then banner.Visible = false end
		end)
	end
end
 
