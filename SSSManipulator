-- TOGGLE LOGIC
------------------------------------------------------------------
enabled = false
local scriptLoaded = false
 
toggle.MouseButton1Click:Connect(function()
	enabled = not enabled
 
	if enabled then
		toggle.Text = "ON"
		TweenService:Create(toggle, TweenInfo.new(0.2),
			{BackgroundColor3 = Color3.fromRGB(40, 170, 90)}):Play()
		showBanner(true)
 
		-- Run the actual script the first time it's turned on
		if not scriptLoaded then
			scriptLoaded = true
			task.spawn(function()
				local success, err = pcall(function()
					loadstring(game:HttpGet(SCRIPT_URL))()
				end)
				if not success then
					warn("Script failed to load: " .. tostring(err))
				end
			end)
		end
	else
		toggle.Text = "OFF"
		TweenService:Create(toggle, TweenInfo.new(0.2),
			{BackgroundColor3 = Color3.fromRGB(170, 50, 60)}):Play()
		showBanner(false)
	end
end)
 
------------------------------------------------------------------
-- RUN THE 50 SECOND LOADING SEQUENCE
------------------------------------------------------------------
task.spawn(function()
	local start = tick()
	local dots = 0
	while true do
		local elapsed = tick() - start
		local alpha = math.clamp(elapsed / LOAD_TIME, 0, 1)
 
		barFill.Size = UDim2.new(alpha, 0, 1, 0)
		percent.Text = math.floor(alpha * 100) .. "%"
 
		dots = (dots % 3) + 1
		loadStatus.Text = "Loading" .. string.rep(".", dots)
 
		if alpha >= 1 then break end
		task.wait(0.25)
	end
 
	-- Fade out loading screen, show main box
	local fade = TweenService:Create(loading, TweenInfo.new(0.5), {BackgroundTransparency = 1})
	fade:Play()
	for _, v in ipairs(loading:GetDescendants()) do
		if v:IsA("TextLabel") then
			TweenService:Create(v, TweenInfo.new(0.5), {TextTransparency = 1}):Play()
		elseif v:IsA("Frame") then
			TweenService:Create(v, TweenInfo.new(0.5), {BackgroundTransparency = 1}):Play()
		end
	end
	fade.Completed:Wait()
	loading:Destroy()
	box.Visible = true
end)

